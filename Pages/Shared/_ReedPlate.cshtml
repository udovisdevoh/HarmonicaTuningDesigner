@model ReedPlateViewModel

@{
    var plateId = (string)ViewData["PlateId"] ?? string.Empty;
}

<div class="reedplate" data-plate="@plateId">
<div class="reedplate-controls">
    <label>Key</label>
    <select asp-for="Key">
        @foreach (var key in (List<string>)ViewData["AvailableKeys"])
        {
            <option>@key</option>
        }
    </select>

    <label>Tuning</label>
    <select asp-for="Tuning">
        @foreach (var tuning in (List<string>)ViewData["AvailableTunings"])
        {
            <option>@tuning</option>
        }
    </select>

    <label>Mode</label>
    <div class="mode-with-rotate">
        <select asp-for="Mode">
            @foreach (var mode in (List<string>)ViewData["AvailableModes"])
            {
                <option>@mode</option>
            }
        </select>

        <!-- Rotate buttons submit the form with plate id and direction in the value -->
        <button type="submit" name="rotateMode" value="@(plateId + ":up")" title="Rotate up (circle of fifths)">▲</button>
        <button type="submit" name="rotateMode" value="@(plateId + ":down")" title="Rotate down (circle of fifths)">▼</button>
    </div>
</div>

<div class="harmonica-grid">

    <!-- Column for each hole; blow above draw in the same column -->
    @for (int i = 0; i < Model.Holes.Count; i++)
    {
        var hole = Model.Holes[i];
        <div class="hole-column">
            <div class="hole-id">@hole.Index</div>

            <div class="note-cell blow"
                 data-hole="@hole.Index"
                 data-type="blow"
                 data-note="@(hole.Blow?.Note ?? string.Empty)"
                 data-octave="@(hole.Blow?.Octave.ToString() ?? string.Empty)">
                <span>@(FormatNote(hole.Blow))</span>
                @if (hole.Blow.IsAltered)
                {
                    <small>*</small>
                }

                <!-- Hidden inputs so posted form contains current hole values and they survive across postbacks -->
                <input type="hidden" name="@($"ViewModel.{plateId}.Holes[{i}].Index")" value="@hole.Index" />
                <input type="hidden" name="@($"ViewModel.{plateId}.Holes[{i}].Blow.Note")" value="@(hole.Blow?.Note ?? string.Empty)" />
                <input type="hidden" name="@($"ViewModel.{plateId}.Holes[{i}].Blow.Octave")" value="@(hole.Blow?.Octave.ToString() ?? string.Empty)" />
                <input type="hidden" name="@($"ViewModel.{plateId}.Holes[{i}].Blow.IsAltered")" value="@(hole.Blow.IsAltered.ToString())" />

                <div class="pitch-controls">
                    <button type="button" class="pitch-btn" data-plate="@plateId" data-array-index="@i" data-side="blow" data-dir="up" title="Raise pitch">▲</button>
                    <button type="button" class="pitch-btn" data-plate="@plateId" data-array-index="@i" data-side="blow" data-dir="down" title="Lower pitch">▼</button>
                </div>
            </div>

            <div class="note-cell draw"
                 data-hole="@hole.Index"
                 data-type="draw"
                 data-note="@(hole.Draw?.Note ?? string.Empty)"
                 data-octave="@(hole.Draw?.Octave.ToString() ?? string.Empty)">
                <span>@(FormatNote(hole.Draw))</span>
                @if (hole.Draw.IsAltered)
                {
                    <small>*</small>
                }

                <!-- Hidden inputs for draw -->
                <input type="hidden" name="@($"ViewModel.{plateId}.Holes[{i}].Draw.Note")" value="@(hole.Draw?.Note ?? string.Empty)" />
                <input type="hidden" name="@($"ViewModel.{plateId}.Holes[{i}].Draw.Octave")" value="@(hole.Draw?.Octave.ToString() ?? string.Empty)" />
                <input type="hidden" name="@($"ViewModel.{plateId}.Holes[{i}].Draw.IsAltered")" value="@(hole.Draw.IsAltered.ToString())" />

                <div class="pitch-controls">
                    <button type="button" class="pitch-btn" data-plate="@plateId" data-array-index="@i" data-side="draw" data-dir="up" title="Raise pitch">▲</button>
                    <button type="button" class="pitch-btn" data-plate="@plateId" data-array-index="@i" data-side="draw" data-dir="down" title="Lower pitch">▼</button>
                </div>
            </div>
        </div>
    }

</div>
</div>

@functions {
    private string FormatNote(NoteCell cell)
    {
        if (cell == null) return string.Empty;
        // If Note already looks like a letter (contains letters) just show Note+Octave
        if (cell.Note.Any(char.IsLetter))
            return $"{cell.Note}{cell.Octave}";

        // Otherwise, if the Note is numeric (MIDI) convert to letter+octave
        if (int.TryParse(cell.Note, out var midi))
        {
            return MidiToNoteName(midi);
        }

        return $"{cell.Note}{cell.Octave}";
    }

    private string MidiToNoteName(int midi)
    {
        // MIDI note 60 = C4
        var names = new[] { "C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B" };
        var octave = (midi / 12) - 1;
        var name = names[midi % 12];
        return $"{name}{octave}";
    }
}